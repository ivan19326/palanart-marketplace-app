# Server-only. Create .env.local locally or set secrets in the hosting dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
ASSISTANT_ORIGINS=https://palanart.github.io
ASSISTANT_DAILY_LIMIT=100
# Use one process and persistent storage for this file; do not reset it on restart.
ASSISTANT_QUOTA_FILE=assistant/.runtime/quota.json
HOST=127.0.0.1
PORT=8788
ASSISTANT_PREVIEW=0
